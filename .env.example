# ===== Servidor =====
NODE_ENV=production
API_PORT=3040
WORKER_PORT=3041
LOG_LEVEL=info
# Identificador do servico em logs (usado pelo @startap/core/logger).
# Default por app: 'api' (apps/api), 'worker' (apps/worker), 'painel' (painel-admin).
SERVICE_NAME=

# ===== Postgres =====
PG_HOST=postgres
PG_PORT=5432
PG_USER=startap_user
# OBRIGATORIO: sem default — processo aborta no boot se ausente.
# Gere senha forte: openssl rand -base64 24
PG_PASS=
PG_DB=startap_database
# Timeout (ms) para abrir conexao do painel-admin com o Postgres. Default 5000.
PG_CONNECT_TIMEOUT_MS=5000

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
# Senha do Redis. Gere com: openssl rand -hex 32
# PRE-REQUISITO: setar no .env de PROD antes de mergear o PR infra-healthcheck-redis-auth
REDIS_PASSWORD=

# ===== WAHA =====
WAHA_URL=http://waha:3000
WAHA_API_KEY=

# ===== Portal — Reconexão self-service WAHA (ADR 0015) =====
# Feature flag. Ausente/false = OFF (rotas /portal/conexao* escondidas; boot NAO crasha).
# Ligar em Dev/piloto sem novo deploy de codigo. NUNCA hardcoded.
# PORTAL_RECONEXAO_WAHA=false
# Timeout (ms) por chamada WAHA do portal-api. Default 8000.
# PORTAL_WAHA_TIMEOUT_MS=8000

# ===== Portal — Signup self-service + trial 7 dias (Missao 020 F1) =====
# Feature flag. Ausente/false = OFF (POST /auth/signup responde 404; boot NAO crasha).
# ANTES de ligar, provisionar TRIAL_PHONE_PEPPER (portal-api E api) e TS_WEBHOOK_URL
# (portal-api) — validados LAZY no ponto de uso (licao #247: env de feature dormente
# nunca e obrigatoria no boot).
# PORTAL_SIGNUP=false
# Pepper do HMAC dos numeros no trial_ledger (anti trial-farming, LGPD: numero cru
# nunca vai pro banco). NECESSARIO em startap-api (hook de pareamento) E portal-api
# (soft check do signup) — MESMO valor nos dois. Min 16 chars.
# ATENCAO: NUNCA rotacionar — rotacao invalida todos os lookups do ledger.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRIAL_PHONE_PEPPER=
# Matriz dos clones do signup (v1: matriz unica de servicos). Default teste_barbearia.
# PORTAL_SIGNUP_MATRIZ_SLOT=teste_barbearia
# Preco default pos-trial em centavos (decisao Bruno 2026-06-11: R$99,99).
# PORTAL_SIGNUP_AMOUNT_CENTS=9999
# Cadastros por dia por IP (anti farm — doc 020 propoe 3).
# PORTAL_SIGNUP_RATE_MAX=3
# Teto GLOBAL de trials SIMULTANEOS (security review PR #268, P0 #2): cada trial
# vivo = 1 sessao WAHA consumindo RAM na VPS sem swap. Acima do teto o signup
# responde 503 trial_lotado ("estamos lotados"). OPCIONAL, default 10 — NUNCA
# obrigatoria no boot.
# TRIAL_MAX_ATIVOS=10
# trustProxy do portal-api (security review PR #268, P1 #3). Default
# 'loopback,uniquelocal' = so honra X-Forwarded-For anexado por hop em faixa
# privada (NPM/portal-web nos bridges Docker) — cliente NAO consegue forjar o
# proprio IP (bypass do rate-limit). Aceita 'true' | 'false' | CSV de
# IPs/CIDRs/presets do proxy-addr. So mexer se a topologia de proxy mudar.
# PORTAL_TRUST_PROXY=loopback,uniquelocal

# ===== Painel do COLABORADOR (barbeiro de estabelecimento) — portal-api (SCRUM-32) =====
# Kill-switch do login + visao READ-ONLY escopada do colaborador (/auth/login detecta
# role + /colaborador/*). OPCIONAL (ausente/false = OFF): o login NUNCA tenta credencial
# de colaborador (byte-a-byte como hoje) e /colaborador/* responde 404. Feature DORMENTE.
# Pre-req pra usar: o DONO gera usuario+senha do colaborador no gestao (botao GERAR SENHA
# na aba Colaboradores). So estabelecimento. Liga em piloto sem novo deploy. NUNCA hardcoded.
# COLABORADOR_PORTAL_ENABLED=false

# ===== Demo interativa de IA na landing (Missao 023 W6) — portal-api =====
# Endpoint PUBLICO e ANONIMO (POST /demo/chat). TODAS opcionais com default
# seguro (licao #247: feature dormente nunca derruba o boot). Sobe DORMENTE.
# Feature flag. Ausente/false = OFF (POST /demo/chat responde 404). Ligar so apos QA.
# DEMO_ENABLED=false
# Provider: a demo usa DeepSeek (deepseek-chat) por custo (~10x menor que gpt-4o).
# Reusa a MESMA DEEPSEEK_API_KEY ja definida acima. Com DEMO_ENABLED=true e a chave
# AUSENTE, /demo/chat responde 503 (validacao LAZY). NUNCA logada/hardcoded.
# DEMO_MODEL=deepseek-chat
# DEMO_MAX_TOKENS=180
# DEMO_TEMPERATURE=0.5
# DEMO_LLM_TIMEOUT_MS=15000
# ----- Caps anti-abuso/custo (endpoint anonimo = maior risco de custo) -----
# Teto de mensagens por sessao do visitante.
# DEMO_MSG_PER_SESSION=15
# Rate-limit por IP: N / janela (segundos) + burst curto.
# DEMO_RATE_PER_IP=20
# DEMO_RATE_WINDOW_SECONDS=600
# DEMO_BURST_PER_IP=5
# DEMO_BURST_WINDOW_SECONDS=60
# HARD CAP GLOBAL diario (nº de chamadas LLM somando TODOS os visitantes). Corta a
# demo em modo offline ao atingir; alerta (warn) ao cruzar DEMO_DAILY_ALERT_AT.
# DEMO_DAILY_CALL_CAP=5000
# DEMO_DAILY_ALERT_AT=3000
# Truncagem do input do visitante + nº de turns de historico reenviados ao modelo.
# DEMO_MAX_INPUT_CHARS=500
# DEMO_HISTORY_TURNS=8
# Salt opaco do hash de IP no log (LGPD: IP nunca em claro). Opcional.
# DEMO_IP_HASH_SALT=

# ===== Transcrição de áudio (ADR 0020) =====
# Whisper LOCAL (container :9000) é o default. Para mover a transcrição pra
# OpenAI (libera ~1.3 GiB RAM + 2 vCPU da VPS), setar TRANSCRIBE_PROVIDER=openai.
WHISPER_URL=http://whisper:9000
# local (default) | openai — ausente = local (comportamento atual idêntico).
TRANSCRIBE_PROVIDER=local
# Modelo OpenAI de transcrição. Default gpt-4o-mini-transcribe (~US$0.003/min).
# Alternativas: whisper-1 (~US$0.006/min) | gpt-4o-transcribe (mais caro/preciso).
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIBE_TIMEOUT_MS=30000
# Se 'false', NÃO cai pro Whisper local quando a OpenAI falhar (default cai).
TRANSCRIBE_OPENAI_FALLBACK_LOCAL=true

# ===== OpenAI =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4  # modelo padrao da plataforma Startap (definido 2026-05-18)
# Limites de contexto do agente IA (caracteres). Defaults: 12000 / 6000.
AGENT_HISTORY_MAX_CHARS=12000
AGENT_TOOL_RESULT_MAX_CHARS=6000

# ===== DeepSeek (fallback / modelo alternativo) =====
# Quando setado, run-agent.ts pode usar DeepSeek como provider alternativo.
DEEPSEEK_API_KEY=

# ===== Painel admin =====
ADMIN_USER=admin
# OBRIGATORIO: painel falha no boot se ausente, igual a 'admin' ou com menos de 8 chars.
# Gere senha forte: openssl rand -base64 18
ADMIN_PASS=
# Segredo da sessao HTTP (session-based auth). Se ausente, o painel gera um segredo
# efemero por processo — sessoes sao invalidadas a cada restart (usuario precisa relogar).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# URL interna do TypeScript API consumida pelo painel-admin (default: http://api:3040).
TS_API_URL=
# URL do webhook WAHA exposta pelo TypeScript API (default: TS_API_URL + /webhooks/waha).
TS_WEBHOOK_URL=

# ===== Auth do webhook WAHA (P0 security — review do PR #268 + spike 2026-06-11) =====
# Dois mecanismos, AMBOS opcionais no boot (licao do incidente #247). Precedencia no
# apps/api: HMAC_KEY presente -> HMAC governa SOZINHO (header estatico ignorado);
# so SECRET presente -> header estatico; nenhum -> aceita tudo + warn no boot.
# Ativar em prod SO via runbook (ordem importa — sessoes primeiro, env depois):
# docs/runbooks/runbook-waha-webhook-auth.md
#
# PLANO A — HMAC nativo do WAHA: a MESMA key vai em webhooks[].hmac.key na config de
# cada sessao WAHA; o WAHA assina o raw body de cada POST e o apps/api valida
# (timing-safe). Autentica + integridade; o secret nao viaja em cada request.
# O painel-admin usa a MESMA var pra criar sessao WAHA nova ja com hmac.key.
# Gerar: openssl rand -hex 32. NUNCA commitar o valor real.
WAHA_WEBHOOK_HMAC_KEY=
# Nome do header da assinatura e algoritmo. Defaults seguem a doc do WAHA
# (X-Webhook-Hmac em hex + sha512) — o OpenAPI da nossa versao congelada nao crava
# os nomes, por isso sao configuraveis (runbook confirma na cobaia ROUTER_TESTE).
# So definir se a cobaia revelar divergencia. Algoritmo aceito: sha512 | sha256.
#WAHA_WEBHOOK_HMAC_HEADER=x-webhook-hmac
#WAHA_WEBHOOK_HMAC_ALGORITHM=sha512
#
# PLANO B — header estatico: secret compartilhado exigido no header X-Webhook-Secret
# de POST /webhooks/waha (apps/api), enviado via webhooks[].customHeaders da sessao.
# O painel-admin usa a MESMA var pra criar sessao WAHA nova ja com o customHeader.
# Gerar: openssl rand -hex 32. NUNCA commitar o valor real.
WAHA_WEBHOOK_SECRET=

# ===== Worker: limpeza de chat =====
# Dias de retencao do historico de chat antes do job cleanup-chat apagar. Default 30.
CHAT_MEMORY_RETENTION=30
# Dias de retencao de entradas em bot_pausa antes do job cleanup-bot-pausa apagar. Default 30.
BOT_PAUSA_RETENTION_DAYS=30

# Minutos maximos que uma execucao pode ficar em status running antes de ser
# fechada automaticamente pelo job close-stale-running (a cada 15 min). Default 30.
CHAT_STALE_RUNNING_MAX_MINUTES=30

# ===== Worker: limpeza de trials ORFAOS (Missao 020 F1 — condicao 2 do PORTAL_SIGNUP) =====
# Orfao = signup que provisionou clone + sessao WAHA mas NUNCA pareou (trial nunca
# iniciou: flow_clones.trial_status='awaiting' + next_due_date NULL) e passou da idade
# limite. O cron desfaz via teardown compartilhado (mesmo do signup), sob o MESMO
# advisory lock do pareamento. NUNCA toca trial_status none/exempt (Cirilo/matrizes/
# clones manuais) nem o trial_ledger. TODAS opcionais — boot do worker NUNCA crasha
# sem elas (licao #247). Com PORTAL_SIGNUP OFF o job roda e nao faz nada.
# Kill switch ('false' desliga o job sem deploy). Default true.
# TRIAL_ORPHAN_CLEANUP_ENABLED=true
# Idade minima em horas pro signup nunca-pareado virar orfao. Default 72 (3 dias —
# doc 020 nao crava este caso; ajustavel por decisao do Bruno sem deploy).
# TRIAL_ORPHAN_MAX_AGE_HOURS=72
# Padrao cron da rodada. Default horario aos :30. Padrao invalido NAO crasha o boot
# (worker cai pro default e loga alto).
# TRIAL_ORPHAN_CRON=30 * * * *

# ===== Worker: Sistema de Alertas Interno (Missao 021, Fase 1) =====
# Monitora sessoes WAHA de cliente + Lola + /health (db/redis) + PG, e avisa o time
# no WhatsApp via Lola quando algo cai/volta. TODAS opcionais — boot do worker NUNCA
# crasha sem elas (licao #247). DOIS niveis de OFF: (1) ALERTS_ENABLED controla se o
# cron sequer registra; (2) alert_config.enabled (toggle quente na UI do gestao) liga
# o envio sem restart. Pra LIGAR em prod: setar ALERTS_ENABLED=true + restart do worker,
# depois cadastrar numeros e ligar o toggle na UI.
# ALERTS_ENABLED=true
# Padrao cron do monitor. Default a cada 2 min. Padrao invalido NAO crasha (fallback).
# ALERTS_CRON=*/2 * * * *
# URL do /health do startap-api na rede interna Docker (reusa checks.db/checks.redis).
# ALERTS_API_HEALTH_URL=http://startap-api:3040/health
# Hard cap global anti-flood: max de mensagens (somando todos os checks) por janela.
# Protege o numero da Lola num cenario "tudo caiu de uma vez". Defaults 10 msgs / 30 min.
# ALERTS_MAX_PER_WINDOW=10
# ALERTS_WINDOW_MIN=30

# ===== Rastreio de ENTREGA de outbound + alerta de nack/preso (SCRUM-58) =====
# Hoje o app e CEGO a entrega: loga bot.reply-sent no 2xx do WAHA, mas o ack 463 e outros
# nacks acontecem DEPOIS (nivel WhatsApp) e ninguem sabe (Lola 3 dias muda, SCRUM-55). Com
# ON: cada resposta do bot registra o message.id (tabela outbound_messages), o evento
# message.ack atualiza o status (PENDING->SERVER->DEVICE->READ / ERROR) e o worker alerta o
# time (via ALERTAS) em nack TERMINAL ou outbound PRESO sem entrega. Rastreia ENTREGA (ack
# SERVER/DEVICE) e FALHA (nack/-1), NUNCA READ (recibo de leitura pode estar off = falso-neg).
# FLAG UNICA nos DOIS servicos (api registra/atualiza; worker alerta). Default OFF — byte-
# identico. LIGAR = setar nos DOIS + assinar `message.ack` na config das sessoes WAHA (passo
# de deploy SEPARADO) + restart. Decisao ON/OFF e do Bruno.
# MESSAGE_ACK_TRACKING_ENABLED=true
# Cron do alerta (worker). Default a cada 5 min no offset :2. Invalido cai no fallback.
# MESSAGE_ACK_ALERT_CRON=2-59/5 * * * *
# Minutos que um outbound pode ficar sem confirmacao de ENTREGA (PENDING/SERVER) antes de virar
# "preso" e alertar. Default 5.
# MESSAGE_ACK_STUCK_MIN=5
# Cooldown (min) por SESSAO entre alertas de entrega falhando (agregado). Default 360 (6h).
# MESSAGE_ACK_ALERT_COOLDOWN_MIN=360
# Teto de outbounds alertaveis lidos por ciclo (anti-burst). Default 200.
# MESSAGE_ACK_ALERT_MAX_PER_RUN=200
# Retencao (dias) das linhas de tracking (efemeras). Default 7.
# MESSAGE_ACK_RETENTION_DAYS=7

# ===== Bot startap (Lola) =====
# Lista CSV de sessoes WAHA roteadas para o bot startap. Default: 'startap'.
STARTAP_WAHA_SESSIONS=startap

# ===== Google Calendar — criptografia de credenciais at-rest =====
# Chave AES-256-GCM para criptografar gcal_credentials_json no banco.
# OBRIGATORIA no boot do painel-admin e da API.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA commitar o valor real — mantenha apenas no .env do servidor.
GCAL_ENCRYPTION_KEY=

# ===== AbacatePay (pagamento PIX — ADR 0013) =====
# OPCIONAL enquanto o pagamento estiver INATIVO (sem webhook/cron em prod). Os apps
# api/worker SOBEM normalmente sem esta var — a feature e dormente e NAO acopla o uptime
# dos bots (corretiva do postmortem P0 2026-06-09: boot obrigatorio derrubou os apps em
# loop de restart). A exigencia vive no PONTO DE USO: o AbacatePayClient lanca
# AbacatePayNotConfiguredError se for chamado sem a chave.
# Quando o pagamento for ATIVADO, preencha (chave DEV ou PROD). O ambiente e definido PELA
# CHAVE, nao pela URL — trocar Dev->Prod e so rotacionar a key. NUNCA commitar o valor.
ABACATEPAY_API_KEY=
# Base da API. Default https://api.abacatepay.com (raramente muda).
ABACATEPAY_BASE_URL=https://api.abacatepay.com
# F2 (webhook PIX) — validacao DUPLA do webhook /webhooks/abacatepay (apps/api).
# OPCIONAIS no boot (mesmo padrao da API_KEY / postmortem P0): webhook e feature INATIVA
# ate o go-live; a rota responde 503 se chamada sem eles. Validados no PONTO DE USO,
# nunca no boot. NUNCA commitar valor. Key de Prod rotacionada antes do go-live; Dev != Prod.
# - QUERY_SECRET: comparado com ?webhookSecret= (timing-safe).
# - WEBHOOK_SECRET: chave do HMAC-SHA256 base64 sobre o RAW BODY (header X-Webhook-Signature).
ABACATEPAY_WEBHOOK_QUERY_SECRET=
ABACATEPAY_WEBHOOK_SECRET=

# ===== Silencio do bot por perfil de cobranca (ADR 0016) =====
# Quando 'true', o bot de um clone CALA se estiver vencido alem da carencia
# (GRACE_DAYS=3): daysUntilDue(next_due_date) < -3, e SO se houver billing
# (next_due_date E amount_cents>0). Vencido ha 0/1/2/3 dias => ainda RESPONDE.
# OFF (ausente ou 'false', default) = comportamento ATUAL: so flow_enabled=false
# (suspensao manual no gestao) cala. OPCIONAL no boot — ausencia NAO crasha api/worker.
# Reverter a feature = desligar a flag (sem migracao). Eixo derivado puro: nunca
# escreve flow_enabled (perdao = data pro futuro volta o bot sem UPDATE).
BILLING_OVERDUE_SILENCE=false

# ===== READ CUTOVER do tenant_id (ADR 0018, Fase 2b / Passo 3) =====
# Governa SO as LEITURAS AGREGADAS de billing/relatorio (rollup de model_usage e o
# cross-tabela "MRR + uso de IA por cliente"). NAO toca o hot path por-conversa
# (bot_config/bot_prompt por slot na resposta ao cliente — esse fica por slot sempre).
# OFF (ausente ou != 'true', default) = comportamento ATUAL: agrega/junta por `slot`.
# ON ('true') = agrega/junta por `tenant_id` (UUID estavel do clone, backfill da
# migration 045 + dual-write #287). Opcional no boot — ausencia NAO crasha api/worker
# (licao #247). Reverter = desligar a flag (volta a ler por slot, sem migracao).
# ANTES de ligar em prod: rodar a paridade slot-vs-tenant (compareRollupParity) e
# confirmar identical=true — billing errado em cliente pagante (Cirilo/Edu) e
# inaceitavel. NUNCA hardcoded.
# TENANT_READ_CUTOVER=false

# ===== Alertas (numbers to notify on errors) =====
ALERT_DEV_PHONE=
ALERT_OWNER_PHONE=
# Sessao WAHA usada para enviar alertas de antibot. Default: 'startap'.
ALERT_SESSION=startap

# ===== Pacotes de servico (ADR 0025 — BLOCO 2a: modelo + consulta read-only) =====
# Feature DORMENTE. Ausente/false (default) = OFF: o bot NAO expoe a tool
# consultar_pacote NEM injeta o bloco [SEU PACOTE]; inserir_agendamento e byte-a-byte
# o de hoje. Cirilo/Samuel (e qualquer clone) 100% inalterados. A DEDUCAO e o bloco 2b
# (outro PR, tambem gated). OPCIONAL no boot (licao #247: env nova nunca derruba api).
# Ligar SO apos o dono DEFINIR um pacote (CRUD = bloco 2b) e QA controlado.
# PACOTES_ENABLED=false
# Pepper do HMAC dos numeros do CLIENTE FINAL em client_package_credits (LGPD: numero
# cru nunca vai pro banco). PEPPER PROPRIO, distinto de TRIAL_PHONE_PEPPER (decisao
# LGPD do ADR 0025 §4: peppers separados impedem join trivial trial_ledger<->pacotes
# pelo hash). Necessario no startap-api quando PACOTES_ENABLED=true — validado LAZY no
# ponto de uso (sem ele, pacotes degradam pra vazio, sem crash). Min 16 chars.
# ATENCAO: NUNCA rotacionar — rotacao invalida todos os lookups de saldo.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PACKAGE_PHONE_PEPPER=
