# ===== Servidor =====
NODE_ENV=production
API_PORT=3040
WORKER_PORT=3041
LOG_LEVEL=info
# Identificador do servico em logs (usado pelo @startap/core/logger).
# Default por app: 'api' (apps/api), 'worker' (apps/worker), 'painel' (painel-admin).
SERVICE_NAME=

# ===== Postgres =====
PG_HOST=postgres
PG_PORT=5432
PG_USER=startap_user
# OBRIGATORIO: sem default — processo aborta no boot se ausente.
# Gere senha forte: openssl rand -base64 24
PG_PASS=
PG_DB=startap_database
# Timeout (ms) para abrir conexao do painel-admin com o Postgres. Default 5000.
PG_CONNECT_TIMEOUT_MS=5000

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
# Senha do Redis. Gere com: openssl rand -hex 32
# PRE-REQUISITO: setar no .env de PROD antes de mergear o PR infra-healthcheck-redis-auth
REDIS_PASSWORD=

# ===== WAHA =====
WAHA_URL=http://waha:3000
WAHA_API_KEY=

# ===== Portal — Reconexão self-service WAHA (ADR 0015) =====
# Feature flag. Ausente/false = OFF (rotas /portal/conexao* escondidas; boot NAO crasha).
# Ligar em Dev/piloto sem novo deploy de codigo. NUNCA hardcoded.
# PORTAL_RECONEXAO_WAHA=false
# Timeout (ms) por chamada WAHA do portal-api. Default 8000.
# PORTAL_WAHA_TIMEOUT_MS=8000

# ===== Portal — Signup self-service + trial 10 dias (Missao 020 F1) =====
# Feature flag. Ausente/false = OFF (POST /auth/signup responde 404; boot NAO crasha).
# ANTES de ligar, provisionar TRIAL_PHONE_PEPPER (portal-api E api) e TS_WEBHOOK_URL
# (portal-api) — validados LAZY no ponto de uso (licao #247: env de feature dormente
# nunca e obrigatoria no boot).
# PORTAL_SIGNUP=false
# Pepper do HMAC dos numeros no trial_ledger (anti trial-farming, LGPD: numero cru
# nunca vai pro banco). NECESSARIO em startap-api (hook de pareamento) E portal-api
# (soft check do signup) — MESMO valor nos dois. Min 16 chars.
# ATENCAO: NUNCA rotacionar — rotacao invalida todos os lookups do ledger.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRIAL_PHONE_PEPPER=
# Matriz dos clones do signup (v1: matriz unica de servicos). Default teste_barbearia.
# PORTAL_SIGNUP_MATRIZ_SLOT=teste_barbearia
# Preco default pos-trial em centavos (decisao Bruno 2026-06-11: R$99,99).
# PORTAL_SIGNUP_AMOUNT_CENTS=9999
# Cadastros por dia por IP (anti farm — doc 020 propoe 3).
# PORTAL_SIGNUP_RATE_MAX=3
# Teto GLOBAL de trials SIMULTANEOS (security review PR #268, P0 #2): cada trial
# vivo = 1 sessao WAHA consumindo RAM na VPS sem swap. Acima do teto o signup
# responde 503 trial_lotado ("estamos lotados"). OPCIONAL, default 10 — NUNCA
# obrigatoria no boot.
# TRIAL_MAX_ATIVOS=10
# trustProxy do portal-api (security review PR #268, P1 #3). Default
# 'loopback,uniquelocal' = so honra X-Forwarded-For anexado por hop em faixa
# privada (NPM/portal-web nos bridges Docker) — cliente NAO consegue forjar o
# proprio IP (bypass do rate-limit). Aceita 'true' | 'false' | CSV de
# IPs/CIDRs/presets do proxy-addr. So mexer se a topologia de proxy mudar.
# PORTAL_TRUST_PROXY=loopback,uniquelocal

# ===== Whisper =====
WHISPER_URL=http://whisper:9000

# ===== OpenAI =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4  # modelo padrao da plataforma Startap (definido 2026-05-18)
# Limites de contexto do agente IA (caracteres). Defaults: 12000 / 6000.
AGENT_HISTORY_MAX_CHARS=12000
AGENT_TOOL_RESULT_MAX_CHARS=6000

# ===== DeepSeek (fallback / modelo alternativo) =====
# Quando setado, run-agent.ts pode usar DeepSeek como provider alternativo.
DEEPSEEK_API_KEY=

# ===== Painel admin =====
ADMIN_USER=admin
# OBRIGATORIO: painel falha no boot se ausente, igual a 'admin' ou com menos de 8 chars.
# Gere senha forte: openssl rand -base64 18
ADMIN_PASS=
# Segredo da sessao HTTP (session-based auth). Se ausente, o painel gera um segredo
# efemero por processo — sessoes sao invalidadas a cada restart (usuario precisa relogar).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# URL interna do TypeScript API consumida pelo painel-admin (default: http://api:3040).
TS_API_URL=
# URL do webhook WAHA exposta pelo TypeScript API (default: TS_API_URL + /webhooks/waha).
TS_WEBHOOK_URL=

# ===== Worker: limpeza de chat =====
# Dias de retencao do historico de chat antes do job cleanup-chat apagar. Default 30.
CHAT_MEMORY_RETENTION=30
# Dias de retencao de entradas em bot_pausa antes do job cleanup-bot-pausa apagar. Default 30.
BOT_PAUSA_RETENTION_DAYS=30

# Minutos maximos que uma execucao pode ficar em status running antes de ser
# fechada automaticamente pelo job close-stale-running (a cada 15 min). Default 30.
CHAT_STALE_RUNNING_MAX_MINUTES=30

# ===== Bot startap (Lola) =====
# Lista CSV de sessoes WAHA roteadas para o bot startap. Default: 'startap'.
STARTAP_WAHA_SESSIONS=startap

# ===== Google Calendar — criptografia de credenciais at-rest =====
# Chave AES-256-GCM para criptografar gcal_credentials_json no banco.
# OBRIGATORIA no boot do painel-admin e da API.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA commitar o valor real — mantenha apenas no .env do servidor.
GCAL_ENCRYPTION_KEY=

# ===== AbacatePay (pagamento PIX — ADR 0013) =====
# OPCIONAL enquanto o pagamento estiver INATIVO (sem webhook/cron em prod). Os apps
# api/worker SOBEM normalmente sem esta var — a feature e dormente e NAO acopla o uptime
# dos bots (corretiva do postmortem P0 2026-06-09: boot obrigatorio derrubou os apps em
# loop de restart). A exigencia vive no PONTO DE USO: o AbacatePayClient lanca
# AbacatePayNotConfiguredError se for chamado sem a chave.
# Quando o pagamento for ATIVADO, preencha (chave DEV ou PROD). O ambiente e definido PELA
# CHAVE, nao pela URL — trocar Dev->Prod e so rotacionar a key. NUNCA commitar o valor.
ABACATEPAY_API_KEY=
# Base da API. Default https://api.abacatepay.com (raramente muda).
ABACATEPAY_BASE_URL=https://api.abacatepay.com
# F2 (webhook PIX) — validacao DUPLA do webhook /webhooks/abacatepay (apps/api).
# OPCIONAIS no boot (mesmo padrao da API_KEY / postmortem P0): webhook e feature INATIVA
# ate o go-live; a rota responde 503 se chamada sem eles. Validados no PONTO DE USO,
# nunca no boot. NUNCA commitar valor. Key de Prod rotacionada antes do go-live; Dev != Prod.
# - QUERY_SECRET: comparado com ?webhookSecret= (timing-safe).
# - WEBHOOK_SECRET: chave do HMAC-SHA256 base64 sobre o RAW BODY (header X-Webhook-Signature).
ABACATEPAY_WEBHOOK_QUERY_SECRET=
ABACATEPAY_WEBHOOK_SECRET=

# ===== Silencio do bot por perfil de cobranca (ADR 0016) =====
# Quando 'true', o bot de um clone CALA se estiver vencido alem da carencia
# (GRACE_DAYS=3): daysUntilDue(next_due_date) < -3, e SO se houver billing
# (next_due_date E amount_cents>0). Vencido ha 0/1/2/3 dias => ainda RESPONDE.
# OFF (ausente ou 'false', default) = comportamento ATUAL: so flow_enabled=false
# (suspensao manual no gestao) cala. OPCIONAL no boot — ausencia NAO crasha api/worker.
# Reverter a feature = desligar a flag (sem migracao). Eixo derivado puro: nunca
# escreve flow_enabled (perdao = data pro futuro volta o bot sem UPDATE).
BILLING_OVERDUE_SILENCE=false

# ===== Alertas (numbers to notify on errors) =====
ALERT_DEV_PHONE=
ALERT_OWNER_PHONE=
# Sessao WAHA usada para enviar alertas de antibot. Default: 'startap'.
ALERT_SESSION=startap
