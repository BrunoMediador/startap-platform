{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (startap-api)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/api/src/server.ts",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx"],
      "env": {
        "NODE_ENV": "development"
      },
      "envFile": "${workspaceFolder}/.env",
      "outFiles": ["${workspaceFolder}/apps/api/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Worker",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/worker/src/worker.ts",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx"],
      "envFile": "${workspaceFolder}/.env",
      "outFiles": ["${workspaceFolder}/apps/worker/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
