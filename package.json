{
  "name": "startap-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma Startap — bots WhatsApp, agendamento, IA. Migrado de automação visual antiga.",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:api": "npm -w @startap/api run dev",
    "dev:worker": "npm -w @startap/worker run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:migrations": "node scripts/verify-migrations.mjs",
    "test:panel": "node --test painel-admin/test/*.test.js",
    "e2e": "node tests/e2e/scripts/compose.mjs run",
    "e2e:preflight": "node tests/e2e/scripts/compose.mjs preflight",
    "e2e:up": "node tests/e2e/scripts/compose.mjs up",
    "e2e:test": "node tests/e2e/scripts/compose.mjs test",
    "e2e:reset": "node tests/e2e/scripts/compose.mjs reset",
    "e2e:down": "node tests/e2e/scripts/compose.mjs down",
    "e2e:validate": "node tests/e2e/scripts/validate-harness.mjs",
    "e2e:typecheck": "tsc -p tests/e2e/tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "scaffold-bot": "tsx --tsconfig scripts/tsconfig.scripts.json scripts/scaffold-bot.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "1.55.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "_comment_overrides": "SCRUM-102: pins de seguranca em deps TRANSITIVAS de producao (patch/minor, zero major bump). Todas entram via fastify/openai/next, que ainda nao publicaram release puxando a versao corrigida. Remover um pin quando o pai passar a exigir >= a versao aqui. Detalhe do triage no corpo do PR.",
  "overrides": {
    "fast-uri": "^3.1.4",
    "find-my-way": "^9.7.0",
    "form-data": "^4.0.6",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  }
}
