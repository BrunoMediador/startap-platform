[Unit]
Description=Fixed root PostgreSQL dump helper for non-root backup producer
ConditionPathExists=/etc/startap-backup/ENABLED
After=docker.service
Requires=docker.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/startap-backup/dump-helper.sh dump
UMask=0077
TimeoutStartSec=35min
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/etc/startap-backup
ReadWritePaths=/run/startap-backup-producer /run/startap-backup-dump-helper
InaccessiblePaths=/opt/automacoes/code/.env /etc/startap-backup/credentials /var/lib/startap-backup
LimitCORE=0
MemorySwapMax=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=startap-backup-dump-helper
