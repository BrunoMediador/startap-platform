[Unit]
Description=Decrypt latest Startap backup for isolated restore drill
ConditionPathExists=/etc/startap-backup/ENABLED

[Service]
Type=oneshot
User=startap-backup-validator
Group=startap-backup-validator
SupplementaryGroups=startap-backup-readers
ExecStart=/usr/local/libexec/startap-backup/drill-prepare.sh
ExecStopPost=/usr/local/libexec/startap-backup/drill-cleanup.sh
LoadCredential=automation.agekey:/etc/startap-backup/credentials/automation.agekey
RemainAfterExit=yes
RuntimeDirectory=startap-backup-drill
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
TimeoutStartSec=20min
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/var/lib/startap-backup/generations /etc/startap-backup
ReadWritePaths=/run/startap-backup-drill
InaccessiblePaths=/var/lib/startap-backup/incoming /var/lib/startap-backup/sealed /var/lib/startap-backup/drill-journal /var/lib/startap-backup-attestations /var/run/docker.sock /opt/automacoes/code/.env
LimitCORE=0
MemorySwapMax=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=startap-backup-drill-prepare
