[Unit]
Description=Startap independent backup freshness detector
ConditionPathExists=/etc/startap-backup/ENABLED

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/startap-backup/status-refresh.sh
RuntimeDirectory=startap-backup-freshness
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/var/lib/startap-backup/generations /var/lib/startap-backup-attestations /var/lib/startap-backup-status/offsite /var/lib/startap-backup-status/local /etc/startap-backup
ReadWritePaths=/var/lib/startap-backup-status /run/startap-backup-freshness
InaccessiblePaths=/var/lib/startap-backup/incoming /var/lib/startap-backup/sealed /var/run/docker.sock /etc/startap-backup/credentials /opt/automacoes/code/.env
LimitCORE=0
MemorySwapMax=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=startap-backup-freshness
