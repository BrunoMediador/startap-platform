[Unit]
Description=Validate Startap automation age identity through LoadCredential only
ConditionPathExists=/etc/startap-backup/APPROVED_GO_A

[Service]
Type=oneshot
User=startap-backup-validator
Group=startap-backup-validator
ExecStart=/usr/local/libexec/startap-backup/identity-preflight.sh
LoadCredential=automation.agekey:/etc/startap-backup/credentials/automation.agekey
UMask=0077
TimeoutStartSec=2min
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/etc/startap-backup
ReadWritePaths=/var/lib/startap-backup-attestations
InaccessiblePaths=/var/lib/startap-backup /var/lib/startap-backup-uploader /var/run/docker.sock /opt/automacoes/code/.env
LimitCORE=0
MemorySwapMax=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=startap-backup-identity-preflight
