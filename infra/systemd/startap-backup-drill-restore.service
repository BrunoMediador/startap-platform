[Unit]
Description=Restore and validate Startap backup in disposable PG16
ConditionPathExists=/etc/startap-backup/ENABLED
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/startap-backup/restore-drill.sh
ExecStopPost=/usr/bin/systemctl start --wait startap-backup-drill-reconcile.service
UMask=0077
TimeoutStartSec=75min
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_DAC_OVERRIDE
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/etc/startap-backup /run/startap-backup-drill
ReadWritePaths=/run/startap-backup-drill-query /var/lib/startap-backup/drill-journal /var/lib/startap-backup/drills /var/lib/startap-backup-status
InaccessiblePaths=/var/lib/startap-backup/incoming /var/lib/startap-backup/sealed /var/lib/startap-backup/generations /var/lib/startap-backup-attestations /etc/startap-backup/credentials /opt/automacoes/code/.env
LimitCORE=0
MemorySwapMax=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=startap-backup-drill-restore
