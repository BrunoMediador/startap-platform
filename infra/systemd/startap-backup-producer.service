[Unit]
Description=Startap non-root encrypted PostgreSQL backup producer
Documentation=file:/opt/automacoes/code/docs/runbooks/backup-postgres.md
ConditionPathExists=/etc/startap-backup/ENABLED
Wants=startap-backup-dump.path startap-backup-dump-cleanup.path startap-backup-producer-reconcile.path
After=startap-backup-dump.path startap-backup-dump-cleanup.path startap-backup-producer-reconcile.path

[Service]
Type=oneshot
User=startap-backup-producer
Group=startap-backup-producer
SupplementaryGroups=startap-backup-bridge
ExecStartPre=/usr/local/libexec/startap-backup/producer-reconcile-request.sh wait
ExecStart=/usr/local/libexec/startap-backup/producer.sh
ExecStopPost=/usr/local/libexec/startap-backup/producer-reconcile-request.sh async
SuccessExitStatus=10
RuntimeDirectory=startap-backup-producer
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/etc/startap-backup /var/lib/startap-backup/generations
ReadOnlyPaths=/run/startap-backup-bridge/root
ReadWritePaths=/run/startap-backup-producer /run/startap-backup-bridge/producer /var/lib/startap-backup/incoming
InaccessiblePaths=/var/run/docker.sock /run/startap-backup-dump-helper /opt/automacoes/code/.env /etc/startap-backup/credentials /var/lib/startap-backup/sealed /var/lib/startap-backup-attestations
LimitCORE=0
LimitFSIZE=805306368
LimitNOFILE=64
TasksMax=32
MemoryHigh=671088640
MemoryMax=805306368
MemorySwapMax=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=startap-backup-producer
